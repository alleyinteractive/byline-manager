{
    "name": "alleyinteractive/byline-manager",
    "description": "Byline Manager",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Alley Interactive",
            "email": "info@alley.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.6",
        "axepress/wp-graphql-stubs": "^2.26.2",
        "mantle-framework/testkit": "^1.13.4",
        "nunomaduro/collision": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^9.6.38",
        "szepeviktor/phpstan-wordpress": "^2.0.4",
        "yoast/wordpress-seo": "^28.8"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "alleyinteractive/composer-wordpress-autoloader": true,
            "phpstan/extension-installer": true,
            "composer/installers": false
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "lint:fix": [
            "@phpcbf"
        ],
        "phpcs": "phpcs . --basepath=.",
        "phpcbf": "phpcbf . --basepath=.",
        "phpstan": [
            "phpstan analyze --ansi --memory-limit=1G"
        ],
        "phpunit": "phpunit",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
